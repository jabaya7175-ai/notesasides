---
import Site from '../layouts/Site.astro';
import SubscribeBand from '../components/SubscribeBand.astro';
import { listPosts } from '../lib/data.js';
import { magazineHTML, mastheadHTML } from '../lib/render.js';
const posts = await listPosts();
const base = import.meta.env.BASE_URL;
const SECTIONS = ['Essays', 'Reviews', 'Architecture', 'Theology'];
---
<Site bare>
  <Fragment set:html={mastheadHTML(base, SECTIONS)} />
  <div class="mag" id="mag"><Fragment set:html={magazineHTML(posts, base)} /></div>
  <SubscribeBand />
  <script>
    // Posts published since the last build appear right away.
    import { listPosts } from '../lib/data.js';
    import { magazineHTML } from '../lib/render.js';
    listPosts().then((posts) => { if (posts.length) document.getElementById('mag').innerHTML = magazineHTML(posts, import.meta.env.BASE_URL); }).catch(() => {});
  </script>
</Site>

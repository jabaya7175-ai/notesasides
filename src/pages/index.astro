---
import Site from '../layouts/Site.astro';
import Subscribe from '../components/Subscribe.astro';
import { listPosts } from '../lib/data.js';
import { postListHTML } from '../lib/render.js';
import { TAGLINE } from '../lib/config.js';
const posts = await listPosts();
const base = import.meta.env.BASE_URL;
---
<Site>
  <div class="home wide">
    <section class="masthead">
      <h1>Notes &amp; Asides.</h1>
      <p>{TAGLINE}</p>
      <div id="subscribe"><Subscribe /></div>
    </section>
    <div id="posts"><Fragment set:html={postListHTML(posts.slice(0, 20), base, { lead: true })} /></div>
  </div>
  <script>
    // New posts appear before the next site build: refresh the list from the database.
    import { listPosts } from '../lib/data.js';
    import { postListHTML } from '../lib/render.js';
    listPosts().then((posts) => {
      if (posts.length) document.getElementById('posts').innerHTML = postListHTML(posts.slice(0, 20), import.meta.env.BASE_URL, { lead: true });
    }).catch(() => {});
  </script>
</Site>

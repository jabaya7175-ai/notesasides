---
import Site from '../layouts/Site.astro';
---
<Site title="Not found">
  <div class="prose" style="text-align:center">
    <h1>Not found</h1>
    <p><em>That page isn't here.</em></p>
    <p><a href={import.meta.env.BASE_URL}>Return home</a></p>
  </div>
  <script>
    // Posts published since the last build: forward /p/<slug>/ to the live reader.
    const base = import.meta.env.BASE_URL;
    const m = location.pathname.slice(base.length - 1).match(/^\/p\/([^/]+)\/?$/);
    if (m) location.replace(`${base}read/?s=${m[1]}`);
  </script>
</Site>

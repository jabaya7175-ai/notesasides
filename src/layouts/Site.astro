---
import '../styles/site.css';
import { PUBLICATION, TAGLINE, AUTHOR } from '../lib/config.js';
const { title, description = TAGLINE, current = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} · ${PUBLICATION}` : `${PUBLICATION} — ${TAGLINE}`;
---
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title || PUBLICATION}>
  <meta property="og:description" content={description}>
  <meta property="og:site_name" content={PUBLICATION}>
  <meta name="author" content={AUTHOR}>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">
  <script is:inline>document.documentElement.classList.remove('no-js');</script>
</head>
<body>
  <header class="site">
    <a class="wordmark" href={base}>Notes &amp; Asides.</a>
    <nav>
      <a href={`${base}archive/`} aria-current={current === 'archive' ? 'page' : undefined}>Archive</a>
      <a href={`${base}about/`} aria-current={current === 'about' ? 'page' : undefined}>About</a>
      <a href={`${base}#subscribe`}>Subscribe</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="site">
    <a class="wordmark" href={base}>Notes &amp; Asides.</a>
    <p>{TAGLINE}</p>
    <p class="small">© {new Date().getFullYear()} {AUTHOR}</p>
  </footer>
</body>
</html>
